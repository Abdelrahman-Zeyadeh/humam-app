.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ملفات خام كبيرة (~٣٣٠ ميجا) تُولّد الأصول المشحونة بـ assets/ عبر
# tools/build_*.py — قابلة لإعادة التنزيل بخطوات موثَّقة، لا تُرفع لغيت.
# يبقى README.md نفسه متتبَّعاً (يوثّق المصدر/الرخصة/خطوات إعادة البناء).
tools/raw/*
!tools/raw/README.md

# مخرجات بناء منصّات أصلية (Gradle/CocoaPods) — تولَّد تلقائياً، /build/
# بالأعلى ما بيغطّيها لأنها مو بجذر المشروع.
android/build/
android/app/build/
android/.gradle/
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/
