# Miscellaneous
# أداة خارجية محلية (استُخدمت لضغط ملفات adhan الصوتية) — ثنائي كبير (~145
# ميغابايت)، لا يخصّ كود التطبيق ولا يُنشَر معه، كل مطوّر يجيبه بنفسه لو احتاجه.
tools/bin/
# لقطات شاشة مرجعية محلية — ليست أصولاً حقيقية بالتطبيق.
humam_screen*.png
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ملفات خام كبيرة (~٣٣٠ ميجا) تُولّد الأصول المشحونة بـ assets/ عبر
# tools/build_*.py — قابلة لإعادة التنزيل بخطوات موثَّقة، لا تُرفع لغيت.
# يبقى README.md نفسه متتبَّعاً (يوثّق المصدر/الرخصة/خطوات إعادة البناء).
tools/raw/*
!tools/raw/README.md

# مخرجات بناء منصّات أصلية (Gradle/CocoaPods) — تولَّد تلقائياً، /build/
# بالأعلى ما بيغطّيها لأنها مو بجذر المشروع.
android/build/
android/app/build/
android/.gradle/
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/
# Widget Preview related
.widget_preview/

# نسخ PDF خام لمصحف مجمع الملك فهد (ملفات ضخمة، مصدر بيانات وسيط فقط)
tools/mushaf/
tools/v4_tajweed_fonts_for_release/

# قواعد بيانات التفسير الوسيطة (٥٨٢ ميجا، ١٤ ملف) — مصدر محلي وحيد لبناء
# إصدار GitHub Release "Tafsir-v1" المُست hosted فعلياً (راجع
# remote_assets_config.dart)، لا حاجة/فائدة لتتبّعها بـgit — كانت مسحوبة
# بالغلط لتاريخ الفرع (نُظِّف التاريخ بـgit filter-branch، أحد ملفاتها
# تجاوز حد GitHub الأقصى للملف الواحد ١٠٠ ميجا فرفض الدفع بالكامل).
tools/tafsir_editions/*.db

# شظايا الكتب التسع (~٩٠ ميجا) — مخرجات وسيطة لـ
# tools/split_hadith_shards.py، تُعاد توليدها من assets/hadith/hadith.db
# بأمر واحد، والمصدر النهائي يُرفع لإصدارات GitHub (remote_assets_config).
# نفس فلسفة tools/raw وtafsir_editions: تتبّعها بالريبو يكبّر الحجم بلا فائدة.
tools/hadith_shards/*.db

# لقطات Golden test الفاشلة (master/test/isolatedDiff/maskedDiff) — تُولَّد
# آلياً عند فشل المقارنة، المطلوب تعقبه فقط هو goldens/*.png الأساسية.
test/**/failures/

# نسخة JDK محلية بجذر المشروع (~٣٧٠ ميجا) — أداة تطوير محلية، لا علاقة
# لها بمصدر التطبيق؛ انسحبت بالغلط لتاريخ git مرتين (هون وبـandroid/app/
# أيضاً) ونُظِّف التاريخ الكامل (git filter-branch). هذا السطر يمنع تكرار
# الغلطة بأي من المكانين.
/oracleJdk-26/
/android/app/oracleJdk-26/

.claude/
.idea/
.widget_preview/
tools/ 
