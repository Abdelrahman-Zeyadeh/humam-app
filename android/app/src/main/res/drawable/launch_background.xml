<?xml version="1.0" encoding="utf-8"?>
<!-- نفس خلفية/شعار `SplashScreen` (كحلي + أيقونة التطبيق) بدل الأبيض
     الافتراضي — يخفي "الومضة" البيضاء قبل ما محرّك فلاتر يرسم أول فريم،
     فيصير الانتقال من نظام التشغيل لفلاتر متواصل بلا قفزة لون محسوسة. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_navy" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
