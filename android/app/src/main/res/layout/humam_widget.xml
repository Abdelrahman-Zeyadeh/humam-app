<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/humam_widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 1. شريط التاريخ الهجري والتطبيق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="السبت 09 ربيع الأول 1448"
            android:textColor="#C5A059"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="start" />

        <TextView
            android:id="@+id/widget_app_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="هُمَام"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. الصلاة القادمة والعد التنازلي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_hero_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#E7D2A0"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_hero_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="04:43"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/widget_hero_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بعد 04:40"
            android:textColor="#E7D2A0"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="#1FFFFFFF" />
    </LinearLayout>

    <!-- فاصل رفيع -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:background="#1FFFFFFF" />

    <!-- 3. شريط مواقيت الصلاة الستة -->
    <LinearLayout
        android:id="@+id/widget_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="3dp">

        <!-- الفجر -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#E7D2A0"
                android:textSize="9.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/p_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:42"
                android:textColor="#E7D2A0"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#1AFFFFFF" />

        <!-- الشروق -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#80FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:07"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#1AFFFFFF" />

        <!-- الظهر -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#80FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:40"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#1AFFFFFF" />

        <!-- العصر -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#80FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:17"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#1AFFFFFF" />

        <!-- المغرب -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#80FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:13"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#1AFFFFFF" />

        <!-- العشاء -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#80FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:38"
                android:textColor="#80FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- فاصل رفيع -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#1FFFFFFF" />

    <!-- 4. آية الفترة والذكر -->
    <TextView
        android:id="@+id/widget_ayah_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_ayah_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سورة الرعد · آية 28"
        android:textColor="#C5A059"
        android:textSize="9.5sp"
        android:gravity="center"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_dhikr_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📿 ذكر الفترة:"
            android:textColor="#E7D2A0"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dhikr_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
