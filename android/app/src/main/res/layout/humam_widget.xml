<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/humam_widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 1. شريط التاريخ الهجري والتطبيق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="السبت 09 ربيع الأول 1448"
            android:textColor="#F5D78E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="start" />

        <TextView
            android:id="@+id/widget_app_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ هُمَام"
            android:textColor="#F5D78E"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/humam_widget_pill_gold" />
    </LinearLayout>

    <!-- 2. الصلاة القادمة والعد التنازلي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_hero_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#F5D78E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_hero_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="04:43"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/widget_hero_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متبقي 04:40"
            android:textColor="#F5D78E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/humam_widget_pill_gold" />
    </LinearLayout>

    <!-- 3. شريط مواقيت الصلاة الستة ككبسولات أنيقة متطابقة مع بطاقة الصلاة بالتطبيق -->
    <LinearLayout
        android:id="@+id/widget_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- الفجر -->
        <LinearLayout
            android:id="@+id/p_box_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/humam_widget_prayer_active"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#F5D78E"
                android:textSize="9.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/p_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:42"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الشروق -->
        <LinearLayout
            android:id="@+id/p_box_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/humam_widget_prayer_inactive"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:07"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- الظهر -->
        <LinearLayout
            android:id="@+id/p_box_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/humam_widget_prayer_inactive"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:40"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- العصر -->
        <LinearLayout
            android:id="@+id/p_box_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/humam_widget_prayer_inactive"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:17"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- المغرب -->
        <LinearLayout
            android:id="@+id/p_box_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/humam_widget_prayer_inactive"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:13"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- العشاء -->
        <LinearLayout
            android:id="@+id/p_box_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/humam_widget_prayer_inactive"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/p_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#B3FFFFFF"
                android:textSize="9.5sp" />
            <TextView
                android:id="@+id/p_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:38"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. بطاقة داخلية ناعمة لآية اليوم والذكر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/humam_widget_inner_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_ayah_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_ayah_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سورة الرعد · آية 28"
            android:textColor="#F5D78E"
            android:textSize="9.5sp"
            android:gravity="center"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_dhikr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📿 ذكر الفترة:"
                android:textColor="#F5D78E"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_dhikr_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
                android:textColor="#E6FFFFFF"
                android:textSize="9.5sp"
                android:gravity="start"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
