<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- التطبيق كان يعمل بالكامل من بيانات مضمّنة (بلا إنترنت) حتى إضافة
         بث الصوت الليلة — everyayah.com/mp3quran.net يحتاجان هذا الإذن،
         وإلا يفشل الاتصال صامتاً بجهاز أندرويد فعلي رغم صحّة الرابط. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- لموقع GPS (مواقيت الصلاة/القبلة) — اختياري، المستخدم يقدر يختار
         مدينة يدوياً بدله. غير مُختبر بجهاز فعلي، راجع
         prayer_location_controller.dart. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- لتشغيل الصوت بالخلفية والتحكّم من إشعار النظام/شاشة القفل عبر
         حزمة audio_service. غير مُختبرة بجهاز فعلي بعد — راجع
         quran_audio_handler.dart. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- إشعارات أذان مواقيت الصلاة (flutter_local_notifications) — غير
         مُختبرة بجهاز فعلي بعد، راجع adhan_notification_service.dart.
         POST_NOTIFICATIONS: إذن وقت التشغيل بأندرويد 13+، يُطلب صراحة
         بالكود. SCHEDULE_EXACT_ALARM: قد يحتاج تفعيلاً يدوياً من المستخدم
         بأندرويد 12+ (الخدمة تتراجع تلقائياً لجدولة غير دقيقة لو رُفض،
         لا تفشل صامتة). RECEIVE_BOOT_COMPLETED: يسمح لإشعارات مجدولة
         بالبقاء بعد إعادة تشغيل الجهاز. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- عمداً بلا USE_EXACT_ALARM: إذن مقيَّد بمتجر Play للتطبيقات التي
         "المنبّه/التقويم" وظيفتها الجوهرية فقط، ومراجعته يدوية قد تُعطّل
         النشر بلا داعٍ. SCHEDULE_EXACT_ALARM كافٍ (يحتاج موافقة يدوية من
         المستخدم بأندرويد 12+ عبر "التنبيهات والتذكيرات")، مع تراجع تلقائي
         لجدولة غير دقيقة لو رُفض. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- وضع "لا تُزعجني وقت القراءة" (كتم إشعارات الجهاز تلقائياً أثناء
         فتح المصحف) — هذا إذن عادي فقط يسمح باستدعاء
         NotificationManager.setInterruptionFilter؛ **الوصول الفعلي**
         لسياسة الإشعارات (Notification Policy Access) تصريح خاص إضافي
         يمنحه المستخدم يدوياً من الإعدادات (لا رسالة نظام قياسية) — راجع
         `MainActivity.kt` وDartـها `lib/core/platform/dnd_service.dart`.
         غير مُختبر بجهاز فعلي بعد. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- اختصارات نظام أندرويد (App Shortcuts، ضغطة مطوّلة على الأيقونة)
                 — راجع res/xml/shortcuts.xml. -->
            <meta-data
              android:name="android.app.shortcuts"
              android:resource="@xml/shortcuts"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- ضغطة ويدجت الشاشة الرئيسية تفتح هذا Activity — راجع
                 HumamWidgetProvider.kt (HomeWidgetLaunchIntent.getActivity). -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="humam"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- تشخيص ٢٠٢٦-٠٨-٢٢: تعطيل Impeller **لم يحل** الشاشة الحمراء —
             تأكّدت فعلياً (`dumpsys gfxinfo` على الجهاز بهالبناء بالذات)
             إنه Pipeline=Skia (OpenGL)، ومع هيك الشاشة احمرّت بنفس صفحة
             الفاتحة بعد حذف كامل للتطبيق وتنصيب نظيف. يعني تخمين الجولة
             السابقة (Impeller/Huawei-red) غلط — **لا تُعِد تفعيل هذا
             التعطيل بناءً على تلك النظرية القديمة**. أُزيل التعطيل هون
             لاختبار Impeller كبديل (GPU الجهاز فعلياً Adreno لا Mali،
             فالسيناريو المرجعي بمشاكل Huawei/Mali أصلاً غير مطابق) — لو
             ظهرت الشاشة الحمراء **معه أيضاً** فهذا دليل إضافي إنه المحرّك
             (Impeller أو Skia) مش السبب الجذري، والاشتباه ينتقل لتعقيد
             الگليف الشعاعي بخط QCF نفسه (راجع محادثة التشخيص وملف الذاكرة
             لتفاصيل أكتر لو استمر البحث). -->

        <!-- خدمة audio_service للتشغيل بالخلفية + إشعار التحكّم. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- flutter_local_notifications: يعيد جدولة إشعارات الأذان القادمة
             بعد إعادة تشغيل الجهاز (AlarmManager يفقد التنبيهات المجدولة
             عند إيقاف التشغيل). غير مُختبر فعلياً بإعادة تشغيل جهاز حقيقي. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- ويدجت هُمَام الشامل (آية وصلاة) -->
        <receiver
            android:name=".HumamWidgetProvider"
            android:exported="true"
            android:label="هُمَام - الشامل">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/humam_widget_info"/>
        </receiver>

        <!-- ويدجت مواقيت الصلاة الشريطي (4×1) -->
        <receiver
            android:name=".PrayerBarWidgetProvider"
            android:exported="true"
            android:label="هُمَام - مواقيت الصلاة (4×1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_bar_widget_info"/>
        </receiver>

        <!-- ويدجت الأذكار والتسبيح (2×2) -->
        <receiver
            android:name=".DhikrWidgetProvider"
            android:exported="true"
            android:label="هُمَام - الأذكار والتسبيح (2×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dhikr_widget_info"/>
        </receiver>

        <!-- ويدجت الآية والذكر (4×2) -->
        <receiver
            android:name=".AyahDhikrWidgetProvider"
            android:exported="true"
            android:label="هُمَام - الآية والذكر (4×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ayah_dhikr_widget_info"/>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
