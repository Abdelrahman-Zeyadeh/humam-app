// ============================================================================
// قواعد أمان Cloud Firestore لتطبيق هُمَام (Humam App)
// لنشر هذه القواعد إلى Firebase:
//   firebase deploy --only firestore:rules
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // اشتراط تسجيل الدخول (بما فيه المجهول) لجميع العمليات
    function isAuthenticated() {
      return request.auth != null;
    }

    // ملف المستخدم الشخصي (المزامنة السحابية — CloudSyncService: الاسم/
    // الصورة/لون التمييز/خطط الختمة والحفظ/العلامات المرجعية). خاص تماماً
    // بصاحبه، لا قراءة/كتابة مشتركة إطلاقاً — خلاف مجموعات الصحبة.
    // **ملاحظة مهمة**: هذا المسار كان غير موجود بالملف سابقاً بلا أي قاعدة
    // له إطلاقاً — لو هذه هي القواعد الفعلية المنشورة بـFirebase Console
    // (لا نسخة "test mode" مفتوحة)، كل عمليات تسجيل الدخول بالبريد/Google
    // ورفع/تنزيل بيانات الحساب كانت سترجع "permission-denied" دائماً.
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // مجموعات الصحبة الإيمانية
    match /groups/{groupId} {
      // السماح بقراءة المجموعات لأي مستخدم موثّق (للبحث بالرمز أو عرض التفاصيل)
      allow read: if isAuthenticated();

      // إنشاء المجموعة مسموح فقط إذا كان المنشئ هو المستخدم الموثّق الحالي
      allow create: if isAuthenticated() 
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.membersCount == 1;

      // تحديث بيانات المجموعة — مقصور فعلياً على تعديل membersCount بمقدار ١
      // فقط (الانضمام/المغادرة عبر GroupsService، راجع joinGroupByCode/
      // leaveGroup)، لا تحديث حرّ. **لم نطلب أن يكون الكاتب عضواً مسبقاً**
      // عمداً — عضو جديد ينضمّ لأول مرة ليس عضواً بعد لحظة كتابة هذا التحديث
      // نفسها. أي حقل آخر (name/code/creatorId/description/emoji) محصَّن من
      // التعديل بهذا المسار بالكامل — قبل هذا التعديل كان أي مستخدم موثّق
      // (حتى مجهول) يقدر يُعدّل أي حقل بأي مجموعة يعرف معرّفها.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membersCount'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.code == resource.data.code
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.description == resource.data.description
        && request.resource.data.emoji == resource.data.emoji
        && (request.resource.data.membersCount == resource.data.membersCount + 1
            || request.resource.data.membersCount == resource.data.membersCount - 1);

      // حذف المجموعة مسموح فقط لمنشئها
      allow delete: if isAuthenticated() 
        && resource.data.creatorId == request.auth.uid;

      // أعضاء المجموعة (Subcollection: members)
      match /members/{userId} {
        allow read: if isAuthenticated();
        
        // العضو يستطيع فقط كتابة/تحديث/حذف مستند عضويته الخاص
        allow create, update: if isAuthenticated() 
          && request.auth.uid == userId
          && request.resource.data.userId == userId;
          
        allow delete: if isAuthenticated() 
          && request.auth.uid == userId;
      }

      // التحديات الجماعية بموعد نهائي (Subcollection: challenges)
      match /challenges/{challengeId} {
        allow read: if isAuthenticated();

        // أي عضو موثّق يقدر ينشئ تحدياً باسمه، بحقول أساسية صحيحة النوع
        allow create: if isAuthenticated()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.archived == false
          && request.resource.data.title is string
          && request.resource.data.targetValue is int;

        // التحديث الوحيد المسموح بعد الإنشاء: منشئ التحدي يقلب `archived`
        // من false إلى true فقط (أرشفة) — لا تعديل حرّ لأي حقل آخر.
        allow update: if isAuthenticated()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived'])
          && resource.data.archived == false
          && request.resource.data.archived == true;

        allow delete: if false;

        // تقدّم كل عضو بالتحدي (Subcollection: progress) — نفس نمط
        // `members/{userId}` تماماً: كل عضو يكتب فقط مستند تقدّمه الخاص،
        // مع اشتراك أن يكون فعلاً عضواً في المجموعة المالكة للتحدي
        // (كان مفتوحاً لأي موثّق يكتب لأي تحدي يعرف معرّفه).
        match /progress/{userId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated()
            && request.auth.uid == userId
            && request.resource.data.userId == userId
            && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
          allow delete: if false;
        }
      }

      // رسائل ونكزات التشجيع (Subcollection: nudges) — إرسال النكزة
      // مشروط بmembership فعلي في المجموعة (كان أي موثّق يقدر يبعت نكزة
      // لأي toUserId بأي مجموعة يعرف معرّفها)، مع منع أي تعديل/حذف.
      match /nudges/{nudgeId} {
        allow read: if isAuthenticated();
        
        // إنشاء النكزة فقط من عضو موثّق في المجموعة نفسه مع التحقق من
        // صحة الحقول وأن المرسل/المستقبلاً أعضاء فعليون
        allow create: if isAuthenticated()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.toUserId is string
          && request.resource.data.message is string
          && request.resource.data.type is string
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.toUserId));
          
        // لا يُسمح بتعديل النكزات بعد إرسالها
        allow update, delete: if false;
      }
    }
  }
}
